# ~/.ssh/config — managed by dotfiles (gnu stow: ssh package)
#
# This file contains ONLY host -> identity mappings. NO private key material
# ever lives in this repo. Private keys (auth_ed25519, signing_ed25519) stay in
# ~/.ssh/ and are backed up encrypted (e.g. KeePass), never committed.
#
# IdentitiesOnly yes — never offer unrelated keys; only the explicit IdentityFile
# is tried. Improves security and avoids "Too many authentication failures".

# --- GitHub (push/pull auth) ---
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- GitLab ---
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- Bitbucket ---
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- Stancona VPS (Tailscale — PLAN-0022 management transport) ---
# 2026-11-25: ssh.stancona.org CF Access tunnel was never migrated in the
# Oct Netcup move (no cloudflared ssh ingress on any box, no tunnel CNAME
# in DNS) -> broken. Daily access = Tailscale; history shows `vps` was
# used for Coolify ops, and Coolify lives on emin-vps-01.
# Break-glass CF path kept below as `vps-cf` (needs tunnel+DNS+challenge fix).
Host vps
    HostName 100.64.209.64
    User emin
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- Break-glass: CF Access SSH (currently BROKEN until tunnel restored) ---
Host vps-cf
    HostName ssh.stancona.org
    User emin
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h

