# ~/.ssh/config — managed by dotfiles (gnu stow: ssh package)
#
# This file contains ONLY host -> identity mappings. NO private key material
# ever lives in this repo. Private keys (auth_ed25519, signing_ed25519) stay in
# ~/.ssh/ and are backed up encrypted (e.g. KeePass), never committed.
#
# IdentitiesOnly yes — never offer unrelated keys; only the explicit IdentityFile
# is tried. Improves security and avoids "Too many authentication failures".

# --- GitHub (push/pull auth) ---
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- GitLab ---
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- Bitbucket ---
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes

# --- Stancona VPS (via Cloudflare Tunnel + Access) ---
Host vps
    HostName ssh.stancona.org
    User emin
    IdentityFile ~/.ssh/auth_ed25519
    IdentitiesOnly yes
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
